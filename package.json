{
  "name": "promptbox",
  "version": "0.1.0",
  "description": "极简提示词管理工具 — 随时记录、分类管理、一键取用",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "frog-716",
  "homepage": "https://github.com/frog-716/PromptBox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frog-716/PromptBox.git"
  },
  "bugs": {
    "url": "https://github.com/frog-716/PromptBox/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "prompt-manager",
    "prompt-library",
    "local-first",
    "vue"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "showcase:screenshot": "node scripts/showcase-screenshot.mjs",
    "zip": "wxt zip",
    "test": "node --experimental-strip-types --test tests/*.test.js",
    "typecheck": "vue-tsc --noEmit",
    "check:arch": "node scripts/check-architecture.mjs",
    "verify": "npm run typecheck && npm run check:arch",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
